# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
NODE_ENV=production

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=mxil
DATABASE_PASSWORD=your_secure_password_here
DATABASE_NAME=mxil
DATABASE_SSL_MODE=require

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security Configuration
JWT_SECRET=your_32_character_super_secret_jwt_key_here
ENCRYPTION_KEY=32_byte_encryption_key_for_data_protection
JWT_EXPIRATION=24h

# Email Configuration
EMAIL_DOMAIN=yourdomain.com
DEFAULT_FROM=noreply@yourdomain.com
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASSWORD=smtp_password
DKIM_PRIVATE_KEY=path/to/private.key

# Network Configuration
ENABLE_I2P=false
I2P_ROUTER_HOST=localhost
I2P_ROUTER_PORT=7657
ENABLE_TOR=false
TOR_PROXY_HOST=localhost
TOR_PROXY_PORT=9050
ENABLE_IPFS=false
IPFS_GATEWAY=https://ipfs.io

# Storage Configuration
STORAGE_BACKEND=local
STORAGE_PATH=./data/storage
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=./logs/mxil.log

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_BURST=100

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_MFA=true
ENABLE_AUDIT_LOGGING=true

# Application URLs
APP_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com
WEB_URL=https://web.yourdomain.com

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30s

# Advanced Settings
MAX_UPLOAD_SIZE=104857600  # 100MB
MAX_EMAIL_SIZE=52428800    # 50MB
SESSION_TIMEOUT=3600       # 1 hour
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m